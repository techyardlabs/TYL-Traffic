# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Hostinger MySQL or PostgreSQL Connection URI
# Hostinger Cloud MySQL format:
# mysql://u123456789_user:password@srv1234.hstgr.io:3306/u123456789_dbname
# Or PostgreSQL / Neon / Supabase / Cloud SQL:
# postgresql://postgres:password@localhost:5432/sparktraffic?sslmode=require
DATABASE_URL="mysql://u123456789_user:password@srv1234.hstgr.io:3306/u123456789_dbname"

# REDIS_URL: Redis task queue instance URL (Optional, defaults to in-memory queue)
REDIS_URL="redis://default:password@localhost:6379"

# RESIDENTIAL_PROXY_URI: Default residential proxy URL template
RESIDENTIAL_PROXY_URI="http://customer-xyz-zone-res:pass@brd.superproxy.io:22225"

# PORTAL AUTHENTICATION CREDENTIALS
# Authorized Operator Login Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Spark@Admin2025!"
ADMIN_EMAIL="techyardlabs@gmail.com"
AUTH_SECRET="spark-traffic-cluster-secure-auth-secret-key-9988"
